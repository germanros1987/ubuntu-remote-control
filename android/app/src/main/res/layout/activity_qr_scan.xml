<?xml version="1.0" encoding="utf-8"?>
<!--
  The camera preview stays full-bleed (edge-to-edge). The bottom hint is padded
  off the nav bar via a window-insets listener in QrScanActivity so it never
  hides under on-screen nav buttons.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:padding="12dp"
        android:background="#88000000"
        android:textColor="@android:color/white"
        android:text="Point at the QR shown by urc share" />
</FrameLayout>
