#!/usr/bin/env bash
# Ubuntu Remote Control — install via curl (no git)
#
#   curl -fsSL https://github.com/germanros1987/ubuntu-remote-control/releases/latest/download/install | sudo bash
#
set -euo pipefail

if [[ "$(id -u)" -ne 0 ]]; then
  exec sudo -E bash "$0" "$@"
fi

# Local run from checkout
if [[ -f "${BASH_SOURCE[0]:-}" ]] && [[ "${BASH_SOURCE[0]}" != "bash" ]] && [[ "${BASH_SOURCE[0]}" != "-" ]]; then
  _src="${BASH_SOURCE[0]}"
  [[ -L "$_src" ]] && _src="$(readlink -f "$_src")"
  _root="$(cd "$(dirname "$_src")" && pwd)"
  if [[ -f "$_root/Cargo.toml" ]] && [[ -f "$_root/packaging/install.sh" ]]; then
    if [[ "$(uname -s)" == "Darwin" ]] && [[ "${1:-}" == "--role" ]] && [[ "${2:-}" == "client" ]]; then
      export URC_BIN_DIR="${URC_BIN_DIR:-$_root/target/release}"
      if [[ ! -f "$URC_BIN_DIR/urc-client" ]]; then
        echo "Build first: cargo build --release -p urc-client" >&2
        exit 1
      fi
      cp -f "$_root/packaging/scripts/urc" "$URC_BIN_DIR/urc"
      exec bash "$_root/packaging/install-mac-client.sh" "$@"
    fi
    exec bash "$_root/packaging/install.sh" "$@"
  fi
fi

WORKDIR="${URC_WORKDIR:-$(mktemp -d /tmp/urc-install.XXXXXX)}"
cleanup() { [[ -n "${URC_KEEP_WORKDIR:-}" ]] || rm -rf "$WORKDIR"; }
trap cleanup EXIT

echo "==> Ubuntu Remote Control"

GH="${URC_GITHUB:-germanros1987/ubuntu-remote-control}"
BR="${URC_BRANCH:-main}"

# Release tarballs often lag behind main; default to source builds so curl install matches scripts.
# Set URC_ALWAYS_SOURCE=0 to prefer GitHub Release prebuilts when available.
URC_ALWAYS_SOURCE="${URC_ALWAYS_SOURCE:-1}"
if [[ "$URC_ALWAYS_SOURCE" == "1" ]]; then
  export URC_FORCE_BUILD=1
fi

# raw.githubusercontent.com caches branch tips — use commit SHA for fresh packaging scripts
git_sha() {
  curl -fsSL -H "Accept: application/vnd.github+json" \
    "https://api.github.com/repos/${GH}/commits/${BR}" 2>/dev/null \
    | grep -m1 '"sha"' | sed 's/.*"sha": "\([^"]*\)".*/\1/' || true
}
GIT_SHA="$(git_sha)"
if [[ -n "$GIT_SHA" ]]; then
  RAW="https://raw.githubusercontent.com/${GH}/${GIT_SHA}"
  echo "==> Using commit ${GIT_SHA:0:7}"
else
  RAW="https://raw.githubusercontent.com/${GH}/${BR}"
  echo "==> Using branch ${BR}"
fi

fetch() {
  curl -fsSL "$RAW/$1" -o "$WORKDIR/$1"
}

if [[ -n "${URC_BINARIES_URL:-}" ]]; then
  echo "==> Installing prebuilt binaries"
  mkdir -p "$WORKDIR/bin" "$WORKDIR/packaging/systemd" "$WORKDIR/packaging/scripts"
  for bin in urc-agent urc-coordinator urc-client urc; do
    curl -fsSL "$URC_BINARIES_URL/$bin" -o "$WORKDIR/bin/$bin"
    chmod +x "$WORKDIR/bin/$bin"
  done
  for f in packaging/install.sh packaging/install-mac-client.sh packaging/scripts/urc \
    packaging/scripts/urc-fix-agent-perms.sh packaging/scripts/urc-recover-x11.sh \
    packaging/scripts/wait-for-session.sh packaging/scripts/urc-health-check.sh \
    packaging/scripts/urc-coordinator-health-check.sh \
    packaging/systemd/urc-agent.service packaging/systemd/urc-coordinator.service \
    packaging/systemd/urc-agent-health.service packaging/systemd/urc-agent-health.timer \
    packaging/systemd/urc-coordinator-health.service packaging/systemd/urc-coordinator-health.timer \
    packaging/systemd/urc-agent-login.path packaging/systemd/urc-agent-login.service; do
    fetch "$f"
  done
  chmod +x "$WORKDIR/packaging/install.sh" "$WORKDIR/packaging/install-mac-client.sh" "$WORKDIR/packaging/scripts/"*
  export URC_SKIP_BUILD=1 URC_BIN_DIR="$WORKDIR/bin" REPO_ROOT="$WORKDIR"
  if [[ "$(uname -s)" == "Darwin" ]]; then
    exec bash "$WORKDIR/packaging/install-mac-client.sh" "$@"
  fi
  exec bash "$WORKDIR/packaging/install.sh" "$@"
fi

mkdir -p "$WORKDIR/packaging/systemd" "$WORKDIR/packaging/scripts"
for f in packaging/install.sh packaging/install-mac-client.sh packaging/scripts/urc \
  packaging/scripts/urc-fix-agent-perms.sh packaging/scripts/urc-recover-x11.sh \
  packaging/scripts/wait-for-session.sh \
  packaging/scripts/urc-health-check.sh \
  packaging/scripts/urc-coordinator-health-check.sh \
  packaging/systemd/urc-agent.service \
  packaging/systemd/urc-coordinator.service \
  packaging/systemd/urc-agent-health.service \
  packaging/systemd/urc-agent-health.timer \
  packaging/systemd/urc-coordinator-health.service \
  packaging/systemd/urc-coordinator-health.timer \
  packaging/systemd/urc-agent-login.path \
  packaging/systemd/urc-agent-login.service; do
  fetch "$f"
done
chmod +x "$WORKDIR/packaging/install.sh" "$WORKDIR/packaging/install-mac-client.sh" "$WORKDIR/packaging/scripts/"*

# Prebuilt binaries from GitHub Releases
if [[ -z "${URC_FORCE_BUILD:-}" ]] && [[ -z "${URC_SOURCE_TARBALL:-}" ]]; then
  ARCH="$(uname -m)"
  if [[ "$(uname -s)" == "Darwin" ]]; then
    case "$ARCH" in
      arm64) PREBUILT_ASSET="darwin-aarch64" ;;
      x86_64) PREBUILT_ASSET="darwin-x86_64" ;;
      *) PREBUILT_ASSET="" ;;
    esac
  else
    case "$ARCH" in
      x86_64|amd64) PREBUILT_ASSET="linux-x86_64" ;;
      aarch64|arm64) PREBUILT_ASSET="linux-aarch64" ;;
      *) PREBUILT_ASSET="" ;;
    esac
  fi
  if [[ -n "$PREBUILT_ASSET" ]]; then
    mkdir -p "$WORKDIR/bin"
    while IFS= read -r tag; do
      [[ -z "$tag" ]] && continue
      url="https://github.com/${GH}/releases/download/${tag}/${PREBUILT_ASSET}.tar.gz"
      if curl -fsSL "$url" 2>/dev/null | tar xz -C "$WORKDIR/bin" 2>/dev/null; then
        echo "==> Using prebuilt binaries (${PREBUILT_ASSET} from ${tag})"
        export URC_SKIP_BUILD=1 URC_BIN_DIR="$WORKDIR/bin" REPO_ROOT="$WORKDIR"
        if [[ "$(uname -s)" == "Darwin" ]]; then
          exec bash "$WORKDIR/packaging/install-mac-client.sh" "$@"
        fi
        export URC_CLIENT_BINARIES_INSTALLED=1
        exec bash "$WORKDIR/packaging/install.sh" "$@"
      fi
    done < <(curl -fsSL "https://api.github.com/repos/${GH}/releases?per_page=15" 2>/dev/null \
      | grep '"tag_name"' | sed 's/.*"tag_name": "\([^"]*\)".*/\1/' || true)
    echo "==> No prebuilt ${PREBUILT_ASSET}; building from source"
  fi
fi

if [[ -n "${URC_SOURCE_TARBALL:-}" ]]; then
  echo "==> Downloading source tarball"
  curl -fsSL "$URC_SOURCE_TARBALL" | tar xz -C "$WORKDIR" --strip-components=1
else
  URL="https://github.com/${GH}/archive/${GIT_SHA:-refs/heads/${BR}}.tar.gz"
  echo "==> Downloading source"
  curl -fsSL "$URL" | tar xz -C "$WORKDIR" --strip-components=1
fi

if [[ ! -f "$WORKDIR/packaging/install.sh" ]]; then
  echo "Download failed" >&2
  exit 1
fi

# Cargo builds run as SUDO_USER; workdir must be writable.
if [[ -n "${SUDO_USER:-}" ]] && [[ -d "$WORKDIR" ]]; then
  chown -R "$SUDO_USER:$SUDO_USER" "$WORKDIR"
fi

export REPO_ROOT="$WORKDIR"

build_mac_client_binaries() {
  local root="$1"
  local build_user="${SUDO_USER:-$USER}"
  if [[ -f "$root/target/release/urc-client" ]] && [[ -f "$root/target/release/urc" ]]; then
    return 0
  fi
  echo "==> Building Mac client (first install — may take a few minutes)"
  if ! sudo -u "$build_user" bash -lc 'command -v cargo >/dev/null 2>&1'; then
    echo "==> Installing Rust (rustup)"
    sudo -u "$build_user" bash -lc 'curl -fsSL https://sh.rustup.rs | sh -s -- -y -q --default-toolchain stable'
  fi
  sudo -u "$build_user" bash -lc "cd '$root' && source \"\$HOME/.cargo/env\" && cargo build --release -p urc-client"
  cp -f "$root/packaging/scripts/urc" "$root/target/release/urc"
  chmod +x "$root/target/release/urc-client" "$root/target/release/urc"
}

if [[ "$(uname -s)" == "Darwin" ]] && { [[ "${1:-}" == "--role" ]] && [[ "${2:-}" == "client" ]] || [[ -z "${1:-}" ]]; }; then
  build_mac_client_binaries "$WORKDIR"
  export URC_BIN_DIR="$WORKDIR/target/release"
  exec bash "$WORKDIR/packaging/install-mac-client.sh" "$@"
fi
exec bash "$WORKDIR/packaging/install.sh" "$@"
