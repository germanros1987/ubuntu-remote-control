#!/usr/bin/env bash
# Ubuntu Remote Control — install via curl (no git)
#
#   curl -fsSL https://raw.githubusercontent.com/germanros1987/ubuntu-remote-control/main/install | sudo bash
#
# Optional:
#   URC_GITHUB=germanros1987/ubuntu-remote-control
#   URC_SOURCE_TARBALL=https://your-server/urc-source.tar.gz
#   URC_BINARIES_URL=https://your-server/linux-x86_64
#   URC_RAW_URL=https://raw.githubusercontent.com/germanros1987/ubuntu-remote-control/main
#
set -euo pipefail

if [[ "$(id -u)" -ne 0 ]]; then
  exec sudo -E bash "$0" "$@"
fi

# Local run from checkout: ./install lives next to Cargo.toml
if [[ -f "${BASH_SOURCE[0]:-}" ]] && [[ "${BASH_SOURCE[0]}" != "bash" ]] && [[ "${BASH_SOURCE[0]}" != "-" ]]; then
  _src="${BASH_SOURCE[0]}"
  [[ -L "$_src" ]] && _src="$(readlink -f "$_src")"
  _root="$(cd "$(dirname "$_src")" && pwd)"
  if [[ -f "$_root/Cargo.toml" ]] && [[ -f "$_root/packaging/install.sh" ]]; then
    exec bash "$_root/packaging/install.sh" "$@"
  fi
fi

# --- curl | bash: download with curl, never git ---
WORKDIR="${URC_WORKDIR:-$(mktemp -d /tmp/urc-install.XXXXXX)}"
cleanup() { [[ -n "${URC_KEEP_WORKDIR:-}" ]] || rm -rf "$WORKDIR"; }
trap cleanup EXIT

echo "==> Ubuntu Remote Control"

if [[ -n "${URC_BINARIES_URL:-}" ]]; then
  echo "==> Installing prebuilt binaries"
  mkdir -p "$WORKDIR/bin" "$WORKDIR/packaging/systemd" "$WORKDIR/packaging/scripts"
  for bin in urc-agent urc-coordinator urc-client urc; do
    curl -fsSL "$URC_BINARIES_URL/$bin" -o "$WORKDIR/bin/$bin"
    chmod +x "$WORKDIR/bin/$bin"
  done
  BASE="${URC_RAW_URL:-${URC_INSTALL_URL:-}}"
  if [[ -n "$BASE" ]]; then
    for f in packaging/install.sh packaging/scripts/urc \
      packaging/scripts/wait-for-session.sh \
      packaging/scripts/urc-health-check.sh \
      packaging/scripts/urc-coordinator-health-check.sh \
      packaging/systemd/urc-agent.service \
      packaging/systemd/urc-coordinator.service \
      packaging/systemd/urc-agent-health.service \
      packaging/systemd/urc-agent-health.timer \
      packaging/systemd/urc-coordinator-health.service \
      packaging/systemd/urc-coordinator-health.timer \
      packaging/systemd/urc-agent-login.path \
      packaging/systemd/urc-agent-login.service; do
      curl -fsSL "$BASE/$f" -o "$WORKDIR/$f"
    done
    chmod +x "$WORKDIR/packaging/install.sh" "$WORKDIR/packaging/scripts/"*
  else
    echo "URC_BINARIES_URL requires URC_RAW_URL (packaging file base)" >&2
    exit 1
  fi
  export URC_SKIP_BUILD=1 URC_BIN_DIR="$WORKDIR/bin" REPO_ROOT="$WORKDIR"
  exec bash "$WORKDIR/packaging/install.sh" "$@"
fi

GH="${URC_GITHUB:-germanros1987/ubuntu-remote-control}"
BR="${URC_BRANCH:-main}"
RAW="https://raw.githubusercontent.com/${GH}/${BR}"

# Packaging files (always from repo — small)
mkdir -p "$WORKDIR/packaging/systemd" "$WORKDIR/packaging/scripts"
for f in packaging/install.sh packaging/scripts/urc \
  packaging/scripts/wait-for-session.sh \
  packaging/scripts/urc-health-check.sh \
  packaging/scripts/urc-coordinator-health-check.sh \
  packaging/systemd/urc-agent.service \
  packaging/systemd/urc-coordinator.service \
  packaging/systemd/urc-agent-health.service \
  packaging/systemd/urc-agent-health.timer \
  packaging/systemd/urc-coordinator-health.service \
  packaging/systemd/urc-coordinator-health.timer \
  packaging/systemd/urc-agent-login.path \
  packaging/systemd/urc-agent-login.service; do
  curl -fsSL "$RAW/$f" -o "$WORKDIR/$f"
done
chmod +x "$WORKDIR/packaging/install.sh" "$WORKDIR/packaging/scripts/"*

# Prebuilt binaries from GitHub Releases (fast path — no Rust on target)
if [[ -z "${URC_FORCE_BUILD:-}" ]] && [[ -z "${URC_SOURCE_TARBALL:-}" ]]; then
  ARCH="$(uname -m)"
  case "$ARCH" in
    x86_64|amd64) PREBUILT_ASSET="linux-x86_64" ;;
    aarch64|arm64) PREBUILT_ASSET="linux-aarch64" ;;
    *) PREBUILT_ASSET="" ;;
  esac
  if [[ -n "$PREBUILT_ASSET" ]]; then
    PREBUILT_URL="https://github.com/${GH}/releases/latest/download/${PREBUILT_ASSET}.tar.gz"
    mkdir -p "$WORKDIR/bin"
    if curl -fsSL "$PREBUILT_URL" | tar xz -C "$WORKDIR/bin" 2>/dev/null; then
      echo "==> Using prebuilt binaries (${PREBUILT_ASSET})"
      export URC_SKIP_BUILD=1 URC_BIN_DIR="$WORKDIR/bin" REPO_ROOT="$WORKDIR"
      exec bash "$WORKDIR/packaging/install.sh" "$@"
    fi
    echo "==> No prebuilt release for ${PREBUILT_ASSET}; building from source"
  fi
fi

if [[ -n "${URC_SOURCE_TARBALL:-}" ]]; then
  echo "==> Downloading source tarball"
  curl -fsSL "$URC_SOURCE_TARBALL" | tar xz -C "$WORKDIR" --strip-components=1
else
  URL="https://github.com/${GH}/archive/refs/heads/${BR}.tar.gz"
  echo "==> Downloading source (curl)"
  curl -fsSL "$URL" | tar xz -C "$WORKDIR" --strip-components=1
fi

if [[ ! -f "$WORKDIR/packaging/install.sh" ]]; then
  echo "Download failed or invalid layout in $WORKDIR" >&2
  exit 1
fi

export REPO_ROOT="$WORKDIR"
exec bash "$WORKDIR/packaging/install.sh" "$@"
