#!/usr/bin/env bash
# User-facing wrapper — discover PCs on Tailscale and connect.
set -euo pipefail

CLIENT_ENV="/usr/local/etc/urc/client.env"
[[ -f "$CLIENT_ENV" ]] || CLIENT_ENV="/etc/urc/client.env"
[[ -f "$CLIENT_ENV" ]] || CLIENT_ENV="${HOME}/.config/urc/client.env"

load_client_env() {
  if [[ -f "$CLIENT_ENV" ]]; then
    set -a
    # shellcheck source=/dev/null
    source "$CLIENT_ENV"
    set +a
  fi
  if [[ -z "${URC_TAILSCALE_BIN:-}" ]] && [[ -x /Applications/Tailscale.app/Contents/MacOS/Tailscale ]]; then
    export URC_TAILSCALE_BIN="/Applications/Tailscale.app/Contents/MacOS/Tailscale"
  elif [[ -L /usr/local/bin/tailscale ]] \
      && [[ "$(readlink /usr/local/bin/tailscale 2>/dev/null)" == *Tailscale.app* ]]; then
    export URC_TAILSCALE_BIN="/Applications/Tailscale.app/Contents/MacOS/Tailscale"
  fi
}

# macOS /bin/bash 3.2: "${arr[@]}" on an empty array fails with set -u.
urc_client() {
  local subcmd=$1
  shift
  local coordinator="${URC_COORDINATOR:-}"
  local token="${URC_TOKEN:-}"
  if [[ -n "$coordinator" && -n "$token" ]]; then
    exec urc-client --coordinator "$coordinator" --token "$token" "$subcmd" "$@"
  elif [[ -n "$coordinator" ]]; then
    exec urc-client --coordinator "$coordinator" "$subcmd" "$@"
  elif [[ -n "$token" ]]; then
    exec urc-client --token "$token" "$subcmd" "$@"
  else
    exec urc-client "$subcmd" "$@"
  fi
}

cmd="${1:-}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$cmd" in
  connect|c)
    load_client_env
    host="${1:-${URC_DEFAULT_HOST:-}}"
    if [[ -z "$host" ]]; then
      echo "Usage: urc connect NAME" >&2
      echo "Run: urc hosts" >&2
      exit 1
    fi
    urc_client connect "$host"
    ;;
  status|health)
    if [[ $# -gt 0 ]]; then
      exec urc-agent "$cmd" "$@"
    else
      exec urc-agent "$cmd"
    fi
    ;;
  hosts)
    load_client_env
    urc_client hosts
    ;;
  ""|help|-h|--help)
    cat <<'EOF'
urc — Ubuntu Remote Control (Tailscale)

  urc hosts             List PCs on your tailnet
  urc connect NAME      Open remote desktop
  urc status            Agent health (on remote PC)
  urc health            Exit 0 if agent healthy

Setup:
  Ubuntu PC:   curl install | sudo bash  → choose 1
  Mac/Linux laptop: same installer → choose 2 (macOS auto-selects client)
EOF
    ;;
  *)
    echo "Unknown command: $cmd (try: urc hosts)" >&2
    exit 1
    ;;
esac
