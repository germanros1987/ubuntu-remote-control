#!/usr/bin/env bash
# User-facing wrapper — discover PCs on Tailscale and connect.
set -euo pipefail

CLIENT_ENV="/usr/local/etc/urc/client.env"
[[ -f "$CLIENT_ENV" ]] || CLIENT_ENV="/etc/urc/client.env"
[[ -f "$CLIENT_ENV" ]] || CLIENT_ENV="${HOME}/.config/urc/client.env"

load_client_env() {
  if [[ -f "$CLIENT_ENV" ]]; then
    set -a
    # shellcheck source=/dev/null
    source "$CLIENT_ENV"
    set +a
  fi
  if [[ -z "${URC_TAILSCALE_BIN:-}" ]] && [[ -x /Applications/Tailscale.app/Contents/MacOS/Tailscale ]]; then
    export URC_TAILSCALE_BIN="/Applications/Tailscale.app/Contents/MacOS/Tailscale"
  elif [[ -L /usr/local/bin/tailscale ]] \
      && [[ "$(readlink /usr/local/bin/tailscale 2>/dev/null)" == *Tailscale.app* ]]; then
    export URC_TAILSCALE_BIN="/Applications/Tailscale.app/Contents/MacOS/Tailscale"
  fi
}

# urc-client picks up URC_TAILSCALE_BIN from the environment exported by load_client_env;
# no extra command-line flags are needed for the unified web flow.
urc_client() {
  exec urc-client "$@"
}

cmd="${1:-}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$cmd" in
  connect|c)
    load_client_env
    # Strip leading flags off so we can find the host name.
    args=()
    host=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --bg|--no-open) args+=("$1"); shift ;;
        --local-port) args+=("$1" "$2"); shift 2 ;;
        --*) args+=("$1"); shift ;;
        *) host="$1"; shift; break ;;
      esac
    done
    host="${host:-${URC_DEFAULT_HOST:-}}"
    if [[ -z "$host" ]]; then
      echo "Usage: urc connect [--bg] NAME" >&2
      echo "Run: urc hosts" >&2
      exit 1
    fi
    urc_client connect "$host" "${args[@]+"${args[@]}"}" "$@"
    ;;
  sessions|ls)
    load_client_env
    urc_client sessions
    ;;
  kill|stop)
    target="${1:-}"
    if [[ -z "$target" ]]; then
      echo "Usage: urc kill HOST|PID" >&2
      exit 1
    fi
    urc_client kill "$target"
    ;;
  status|health)
    if [[ $# -gt 0 ]]; then
      exec urc-agent "$cmd" "$@"
    else
      exec urc-agent "$cmd"
    fi
    ;;
  hosts)
    load_client_env
    urc_client hosts
    ;;
  share)
    load_client_env
    exec urc-agent share
    ;;
  ""|help|-h|--help)
    cat <<'EOF'
urc — Ubuntu Remote Control (Tailscale)

  urc hosts                  List PCs on your tailnet
  urc connect NAME           Open remote desktop (foreground; Ctrl+C disconnects)
  urc connect NAME --bg      Start tunnel in background; return immediately
  urc sessions               List background tunnels
  urc kill NAME|PID          Stop a background tunnel
  urc status                 Agent health (on remote PC)
  urc health                 Exit 0 if agent healthy
  urc share                  Show a QR code to pair the Android app (on remote PC)

Setup:
  Ubuntu PC:   curl install | sudo bash  → choose 1
  Mac/Linux laptop: same installer → choose 2 (macOS auto-selects client)
EOF
    ;;
  *)
    echo "Unknown command: $cmd (try: urc hosts)" >&2
    exit 1
    ;;
esac
