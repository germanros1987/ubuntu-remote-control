#!/usr/bin/env bash
# User-facing wrapper — discover PCs on Tailscale and connect.
set -euo pipefail

CLIENT_ENV="/etc/urc/client.env"
[[ -f "$CLIENT_ENV" ]] || CLIENT_ENV="${HOME}/.config/urc/client.env"

cmd="${1:-}"
shift || true

case "$cmd" in
  connect|c)
    [[ -f "$CLIENT_ENV" ]] && set -a && source "$CLIENT_ENV" && set +a
    host="${1:-${URC_DEFAULT_HOST:-}}"
    if [[ -z "$host" ]]; then
      echo "Usage: urc connect NAME" >&2
      echo "Run: urc hosts" >&2
      exit 1
    fi
    extra=()
    [[ -n "${URC_COORDINATOR:-}" ]] && extra+=(--coordinator "$URC_COORDINATOR")
    [[ -n "${URC_TOKEN:-}" ]] && extra+=(--token "$URC_TOKEN")
    exec urc-client "${extra[@]}" connect "$host"
    ;;
  status|health)
    exec urc-agent "${cmd}" "$@"
    ;;
  hosts)
    [[ -f "$CLIENT_ENV" ]] && set -a && source "$CLIENT_ENV" && set +a
    extra=()
    [[ -n "${URC_COORDINATOR:-}" ]] && extra+=(--coordinator "$URC_COORDINATOR")
    exec urc-client "${extra[@]}" hosts
    ;;
  ""|help|-h|--help)
    cat <<'EOF'
urc — Ubuntu Remote Control (Tailscale)

  urc hosts             List PCs on your tailnet
  urc connect NAME      Open remote desktop
  urc status            Agent health (on remote PC)
  urc health            Exit 0 if agent healthy

Setup:
  On each PC to control:  sudo ./install  → choose 1, sign in to Tailscale
  On your laptop:        sudo ./install  → choose 2, same Tailscale account
EOF
    ;;
  *)
    echo "Unknown command: $cmd (try: urc hosts)" >&2
    exit 1
    ;;
esac
