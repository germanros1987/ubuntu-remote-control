# /etc/urc/agent.toml

host_id = "my-workstation"
token = "changeme"

coordinator_url = "ws://your-vps.example.com:21150/ws/agent"
listen_tls_port = 15900
vnc_password_file = "/etc/urc/vncpasswd"
files_root = "/home"

# X11: false prevents network-delayed key releases from generating extra text.
# Disables host hold-to-repeat while sharing (including the physical keyboard).
# Set true to keep host repeat; remote duplicate characters may then recur.
x11_server_key_repeat = false

# encryption = "tls"  # or use --insecure CLI flag

[tailscale]
# Desktop installs enable this automatically (install.sh)
enabled = false
prefer_direct = true

# backend = "auto"  # auto | x11 | gnome | wayvnc
